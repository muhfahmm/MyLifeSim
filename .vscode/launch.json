{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyLifeSim (Web Server Port 3100)",
      "request": "launch",
      "type": "dart",
      "deviceId": "web-server",
      "args": [
        "--web-port=3100"
      ]
    },
    {
      "name": "MyLifeSim (Chrome No Launch - Port 3100)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=3100",
        "--no-web-browser-launch"
      ]
    }
  ]
}
